# deploy/.env としてコピーし、パスワードを自分の値に置き換える。
# make env が未作成なら乱数で生成する。このファイル自体は追跡されるが、
# .env は追跡しない。

# DB のパスワード。compose と BFF/各サービスの DSN の両方で使う。
POSTGRES_PASSWORD=change-me

# Nginx をホストへ公開するポート。
NLOPS_PORT=8081

# HTTPS で公開する場合のポート。証明書が無ければ使われない。
NLOPS_TLS_PORT=8443

# ホストで動いている OpenAI 互換サーバ。
NLOPS_LLM_BASE=http://host.docker.internal:11435
